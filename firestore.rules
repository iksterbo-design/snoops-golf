rules_version = '2';
// AI Golf Coach — Firestore security rules.
// Authorization is enforced here AND in server-side API routes; never rely on
// hidden navigation. Admins are users with role == "admin" (or a custom claim).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
         || request.auth.token.admin == true);
    }
    function ownsUserId(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if ownsUserId(uid) || isAdmin();
      allow create: if ownsUserId(uid);
      allow update, delete: if isAdmin();
    }

    match /credentials/{uid} {
      // password hashes: server-only
      allow read, write: if false;
    }

    match /swings/{swingId} {
      allow read: if resource == null ? signedIn() : ownsUserId(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (ownsUserId(resource.data.userId) && request.resource.data.userId == resource.data.userId);
      allow delete: if ownsUserId(resource.data.userId) || isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if ownsUserId(resource.data.userId) || isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin(); // status changes happen server-side (webhook)
      allow delete: if false;
    }

    match /coachOverrides/{coachId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
