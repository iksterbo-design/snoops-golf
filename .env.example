# ------------------------------------------------------------------
# AI Golf Coach - environment configuration
# Copy to .env.local and fill in only what you have. The app runs
# fully in DEMO MODE with none of these set.
# ------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_NAME="AI Golf Coach"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_SECRET="dev-secret-change-me"

# --- Demo / development mode ---
# true  = simulated payments, uploads, analysis (no external services needed)
# false = requires the real services below
NEXT_PUBLIC_DEMO_MODE="true"

# --- Firebase (optional; app falls back to local JSON store + cookie auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Stripe (optional; demo checkout is simulated when unset) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- LLM (optional; structured mock coach engine used when unset) ---
LLM_PROVIDER="openai"            # openai | anthropic-compatible endpoint
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL=""               # e.g. https://api.openai.com/v1 or a proxy

# --- Media tooling (optional; enables real duration probe + checkpoint frames) ---
# Path to the binaries when they are not on PATH. No keys required.
FFMPEG_PATH=""
FFPROBE_PATH=""

# --- Pose analysis (optional; MediaPipe/MoveNet microservice) ---
POSE_SERVICE_URL=""
POSE_SERVICE_KEY=""

# --- Admin bootstrap ---
ADMIN_EMAIL="admin@example.com"  # first signup with this email becomes admin
ADMIN_PASSWORD="change-me-now"

# --- Storage (optional) ---
STORAGE_DRIVER="local"           # local | firebase
